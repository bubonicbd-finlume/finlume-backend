# Backend Configuration
# Copy this to .env and fill in your values

# ===== REQUIRED =====

# JWT secret for signing/verifying tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-here-min-32-chars

# ===== OPTIONAL (for production) =====

# Database URL (defaults to SQLite in /tmp)
# For Postgres (Supabase):
# DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres
DATABASE_URL=

# Backend port (default: 8000)
PORT=8000

# ===== FRONTEND (in HTML) =====

# Backend API URL (update in finlume_backend_integrated.html)
# BACKEND_API_URL=http://localhost:8000  (local)
# BACKEND_API_URL=https://ledgerly-backend.onrender.com  (production)

# ===== DEPLOYMENT PLATFORMS =====

# For Heroku:
#   heroku config:set JWT_SECRET=$(openssl rand -hex 32) -a your-app-name
#   heroku config:set DATABASE_URL=<your-postgres-url> -a your-app-name

# For Railway:
#   Add these via Railway dashboard → Variables

# For Render:
#   Add these via Render dashboard → Environment

# For Docker:
#   docker run -e JWT_SECRET=<value> -e DATABASE_URL=<value> ledgerly-backend

# ===== NOTES =====

# - Never commit .env to version control
# - JWT_SECRET must be 32+ characters for security
# - Each JWT token should be signed with this secret
# - Change SECRET periodically and re-issue JWTs
